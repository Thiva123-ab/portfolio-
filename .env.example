# Public site URL used in metadata, the sitemap, and robots.txt.
# No trailing slash. Example: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=

# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# A verified Resend sender. Example: Portfolio <noreply@yourdomain.com>
# For local tests, Resend's onboarding sender can be used with the account email.
RESEND_FROM_EMAIL=
